#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT_DIR/.env.local"

say() {
  printf '\n%s\n' "$1"
}

fail() {
  printf '\nОшибка: %s\n' "$1" >&2
  exit 1
}

command -v ruby >/dev/null 2>&1 || fail "Ruby не найден. Установите Ruby 2.6 или новее (рекомендуется 3.1+)."

RUBY_OK="$(ruby -e 'major, minor = RUBY_VERSION.split(".").map(&:to_i); puts((major > 2 || (major == 2 && minor >= 6)) ? "yes" : "no")')"
if [[ "$RUBY_OK" != "yes" ]]; then
  fail "Нужен Ruby 2.6 или новее. Сейчас установлен $(ruby -e 'print RUBY_VERSION')."
fi

command -v bundle >/dev/null 2>&1 || fail "Bundler не найден. Выполните: gem install bundler"

say "Pulse Review — быстрая настройка"
printf 'Ruby %s · Bundler %s\n' "$(ruby -e 'print RUBY_VERSION')" "$(bundle --version | awk '{print $3}')"

RUBY_MAJOR="$(ruby -e 'print RUBY_VERSION.split(".")[0]')"
if [[ "$RUBY_MAJOR" -lt 3 ]]; then
  printf 'Рекомендуется Ruby 3.1 или новее; текущая версия поддерживается в режиме совместимости.\n'
fi

if [[ -f "$ENV_FILE" ]]; then
  printf '\nФайл .env.local уже существует. Перезаписать? [y/N] '
  read -r overwrite
  case "$overwrite" in
    y|Y|yes|YES|да|Да) ;;
    *) say "Настройка отменена: существующий файл сохранён."; exit 0 ;;
  esac
fi

printf '\nАдрес GitLab [https://gitlab.com]: '
read -r gitlab_url
gitlab_url="${gitlab_url:-https://gitlab.com}"
gitlab_url="${gitlab_url%/}"

case "$gitlab_url" in
  http://*|https://*) ;;
  *) fail "Адрес GitLab должен начинаться с http:// или https://" ;;
esac

printf 'GitLab access token (ввод скрыт): '
IFS= read -r -s gitlab_token
printf '\n'
[[ -n "$gitlab_token" ]] || fail "Токен не может быть пустым."

printf 'Порт [4567]: '
read -r app_port
app_port="${app_port:-4567}"
[[ "$app_port" =~ ^[0-9]+$ ]] || fail "Порт должен быть числом."

umask 077
printf 'GITLAB_URL=%s\nGITLAB_TOKEN=%s\nGITLAB_PROJECTS=\nPORT=%s\n' \
  "$gitlab_url" "$gitlab_token" "$app_port" > "$ENV_FILE"

say "Устанавливаю зависимости..."
cd "$ROOT_DIR"
bundle config set --local path vendor/bundle
bundle install

say "Готово. Настройки сохранены локально в .env.local."
printf 'Открыть после запуска: http://127.0.0.1:%s\n' "$app_port"
printf 'Запустить Pulse Review сейчас? [Y/n] '
read -r run_now

case "$run_now" in
  n|N|no|NO|нет|Нет)
    printf '\nПозже запустите: bin/start\n'
    ;;
  *)
    exec "$ROOT_DIR/bin/start"
    ;;
esac
