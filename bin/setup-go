#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT_DIR/.env.local"
BINARY="$ROOT_DIR/.local/bin/pulse-review"

fail() { printf '\nОшибка: %s\n' "$1" >&2; exit 1; }
say() { printf '\n%s\n' "$1"; }

command -v go >/dev/null 2>&1 || fail "Go не найден. Установите Go 1.27 или новее с https://go.dev/dl/."
GO_VERSION="$(go env GOVERSION)"
GO_MINOR="$(printf '%s' "$GO_VERSION" | sed -E 's/^go1\.([0-9]+).*/\1/')"
[[ "$GO_MINOR" =~ ^[0-9]+$ ]] && [[ "$GO_MINOR" -ge 27 ]] || fail "Нужен Go 1.27 или новее. Установлен $GO_VERSION."

say "Pulse Review v0.2.0 — настройка Go-версии"
printf '%s\n' "$GO_VERSION"

if [[ -f "$ENV_FILE" ]]; then
  printf '\nФайл .env.local уже существует. Сохранить его и только пересобрать приложение? [Y/n] '
  read -r keep
  case "$keep" in n|N|no|NO|нет|Нет) ;; *) keep=yes ;; esac
fi

if [[ "${keep:-}" != yes ]]; then
  printf '\nАдрес GitLab [https://gitlab.com]: '
  read -r gitlab_url
  gitlab_url="${gitlab_url:-https://gitlab.com}"
  gitlab_url="${gitlab_url%/}"
  case "$gitlab_url" in http://*|https://*) ;; *) fail "Адрес GitLab должен начинаться с http:// или https://" ;; esac
  printf 'GitLab access token (ввод скрыт): '
  IFS= read -r -s gitlab_token
  printf '\n'
  [[ -n "$gitlab_token" ]] || fail "Токен не может быть пустым."
  printf 'Порт [4567]: '
  read -r app_port
  app_port="${app_port:-4567}"
  [[ "$app_port" =~ ^[0-9]+$ ]] && (( app_port >= 1 && app_port <= 65535 )) || fail "Порт должен быть числом от 1 до 65535."
  umask 077
  printf 'GITLAB_URL=%s\nGITLAB_TOKEN=%s\nGITLAB_PROJECTS=\nPORT=%s\n' "$gitlab_url" "$gitlab_token" "$app_port" > "$ENV_FILE"
fi

say "Собираю Go-приложение..."
mkdir -p "$(dirname "$BINARY")"
cd "$ROOT_DIR"
go build -trimpath -o "$BINARY" .
say "Готово. Запуск: bin/start"
